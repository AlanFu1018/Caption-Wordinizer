{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 760,
    "dDurationMs": 8080,
    "segs": [ {
      "utf8": "皆さん、こんにちは。日本語の森のあいりです。\n試験お疲れ様でした。合格だった方"
    } ]
  }, {
    "tStartMs": 8840,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "おめでとうございます。今回ね、ダメだったっていう方も\nJLPTは年に2回試験があるので"
    } ]
  }, {
    "tStartMs": 15040,
    "dDurationMs": 5982,
    "segs": [ {
      "utf8": "次の試験に向けて一緒にまた\n頑張っていきましょう。そんな中で学生さんたち"
    } ]
  }, {
    "tStartMs": 21022,
    "dDurationMs": 8978,
    "segs": [ {
      "utf8": "からたくさんの質問いただくのですが、\nその中でも特に多いのがJLPTはどうやって勉強すればいいのか。"
    } ]
  }, {
    "tStartMs": 30000,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "どんな本を使えばいいのかという質問をたくさんいただきます。"
    } ]
  }, {
    "tStartMs": 33901,
    "dDurationMs": 7990,
    "segs": [ {
      "utf8": "なので今回はどういう本を使って勉強すればいいのかということを全部シェアしていきたいと思います。"
    } ]
  }, {
    "tStartMs": 41891,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "ステップ1\nまずは絶対に漢字から勉強してください。"
    } ]
  }, {
    "tStartMs": 47271,
    "dDurationMs": 5101,
    "segs": [ {
      "utf8": "でも先生漢字覚えるの難しいよ。分かります。"
    } ]
  }, {
    "tStartMs": 52372,
    "dDurationMs": 6347,
    "segs": [ {
      "utf8": "漢字本当に難しいですよね。じゃあまずはこの漢字を見てください。"
    } ]
  }, {
    "tStartMs": 58719,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "この漢字見たことありますか?これ見ると\nこっちにちょんちょんちょっていう何か"
    } ]
  }, {
    "tStartMs": 65199,
    "dDurationMs": 6841,
    "segs": [ {
      "utf8": "付いてますね。で、こっちに立つという\n漢字があります。これが2つ合わさると"
    } ]
  }, {
    "tStartMs": 72040,
    "dDurationMs": 5759,
    "segs": [ {
      "utf8": "泣くという意味があります。この泣くと\nいう漢字なんですが、こっちの"
    } ]
  }, {
    "tStartMs": 77799,
    "dDurationMs": 7280,
    "segs": [ {
      "utf8": "ちょんちょんちょんさんずいと言います。これは\n水を意味しています。なのでこの泣くと"
    } ]
  }, {
    "tStartMs": 85079,
    "dDurationMs": 7801,
    "segs": [ {
      "utf8": "いう漢字が分からなかったとしてもこのさんずい\nの部首を理解していれば何か水に関係する"
    } ]
  }, {
    "tStartMs": 92880,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "言葉だということがわかります。他にも\nこのさんずいを使った漢字たくさんあります。"
    } ]
  }, {
    "tStartMs": 98920,
    "dDurationMs": 8960,
    "segs": [ {
      "utf8": "なのでまずは部首から覚えてみてください。\nそして2つ目に漢字を覚える時には絶対に"
    } ]
  }, {
    "tStartMs": 107880,
    "dDurationMs": 8080,
    "segs": [ {
      "utf8": "意味と読み方と単語までセットで確認して\nください。漢字の勉強方法たくさんあるんですが、"
    } ]
  }, {
    "tStartMs": 115960,
    "dDurationMs": 7680,
    "segs": [ {
      "utf8": "日本人も小学生の時からずっと\n漢字を勉強してきています。小学生の時は"
    } ]
  }, {
    "tStartMs": 123640,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "ずっと漢字ドリルを使ってたくさん漢字を\n書いていました。なので、ま、それぞれ"
    } ]
  }, {
    "tStartMs": 129000,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "やり方で勉強していただいて構わないん\nですが、たくさん見たり、たくさん書いたり、"
    } ]
  }, {
    "tStartMs": 133720,
    "dDurationMs": 5799,
    "segs": [ {
      "utf8": "とにかくたくさん漢字に触れるよう\nにしてください。復習することがとっても大切です。"
    } ]
  }, {
    "tStartMs": 139519,
    "dDurationMs": 9161,
    "segs": [ {
      "utf8": "ステップ2。次は単語を勉強しましょう。\nここでさっきの漢字の勉強が"
    } ]
  }, {
    "tStartMs": 148680,
    "dDurationMs": 7080,
    "segs": [ {
      "utf8": "生きてきます。単語っていうのは漢字と\n漢字が合わさってできたものが単語ですよね。"
    } ]
  }, {
    "tStartMs": 155760,
    "dDurationMs": 7320,
    "segs": [ {
      "utf8": "なので漢字を覚えておくと読み方や\n意味が自然と理解できるようになるんです。"
    } ]
  }, {
    "tStartMs": 163080,
    "dDurationMs": 8320,
    "segs": [ {
      "utf8": "なので最初に漢字勉強しておくと次の\n単語の勉強が本当に楽になります。"
    } ]
  }, {
    "tStartMs": 171400,
    "dDurationMs": 8080,
    "segs": [ {
      "utf8": "ただ最近のJLPT本当に難しくなってき\nていて、今世の中に出回っている単語帳で"
    } ]
  }, {
    "tStartMs": 179480,
    "dDurationMs": 7920,
    "segs": [ {
      "utf8": "は実際対応できていません。なのでできる\nだけたくさんの単語に触れてください。"
    } ]
  }, {
    "tStartMs": 187400,
    "dDurationMs": 8360,
    "segs": [ {
      "utf8": "特に最近のJLPTでは日常生活に関連し\nた言葉がたくさん出てきます。"
    } ]
  }, {
    "tStartMs": 195760,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "なので、外にお出かけした時、看板を見てみたり、\nスーパーに買い物に行った時に張り紙を見てみる。"
    } ]
  }, {
    "tStartMs": 201920,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "このようにたくさんの漢字に触れることが大切です。\nじゃあどうやって勉強すればいいんだよ。"
    } ]
  }, {
    "tStartMs": 208400,
    "dDurationMs": 7600,
    "segs": [ {
      "utf8": "そう思いますよね。\n単語を勉強する時には単語の意味と読み"
    } ]
  }, {
    "tStartMs": 216000,
    "dDurationMs": 6760,
    "segs": [ {
      "utf8": "方を一緒に勉強してください。\nでもこれだけじゃダめです。"
    } ]
  }, {
    "tStartMs": 222760,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "例文も一緒にセットで確認してください。\n実際単語の読み方は知っている、意味も"
    } ]
  }, {
    "tStartMs": 228720,
    "dDurationMs": 7200,
    "segs": [ {
      "utf8": "知っているだけどこれどういう風に使うの\nと聞かれると分からないという方が意外と"
    } ]
  }, {
    "tStartMs": 235920,
    "dDurationMs": 8080,
    "segs": [ {
      "utf8": "たくさんいるんです。なので単語を覚える\n時には意味や読み方だけではなく例文も"
    } ]
  }, {
    "tStartMs": 244000,
    "dDurationMs": 8239,
    "segs": [ {
      "utf8": "一緒にセットで確認してください。\nステップ3文法です。ただ文法はどの本を"
    } ]
  }, {
    "tStartMs": 252239,
    "dDurationMs": 5441,
    "segs": [ {
      "utf8": "勉強していただいても構いません。皆さん\nが持っている本であったり、本屋さんで"
    } ]
  }, {
    "tStartMs": 257680,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "近くに売っている本でも何でもオッケー\nです。ただ最近のJLPT、特にN1、N２、N3"
    } ]
  }, {
    "tStartMs": 265680,
    "dDurationMs": 9480,
    "segs": [ {
      "utf8": "あたりですね、基礎の文法がたくさん\n出てきています。が、は、に、でも　こんな風に"
    } ]
  }, {
    "tStartMs": 275160,
    "dDurationMs": 6479,
    "segs": [ {
      "utf8": "簡単な文法がたくさん出てきています。\nなので、N1,　N2細かいニュアンスを勉強"
    } ]
  }, {
    "tStartMs": 281639,
    "dDurationMs": 9081,
    "segs": [ {
      "utf8": "するより前に一旦　N4、N5の基礎の文法を\n一旦復習してください。皆さんからよく"
    } ]
  }, {
    "tStartMs": 290720,
    "dDurationMs": 6800,
    "segs": [ {
      "utf8": "この文法とこの文法何が違うのっていう\nことたくさん聞かれるんですけど、"
    } ]
  }, {
    "tStartMs": 297520,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "その細かいニュアンスを勉強するのもオッケー\nです。ただJLPTではその問題は問われません。"
    } ]
  }, {
    "tStartMs": 303880,
    "dDurationMs": 7879,
    "segs": [ {
      "utf8": "なので、一旦細かいところを勉強\nするより先に、N4、N5の基礎の"
    } ]
  }, {
    "tStartMs": 311759,
    "dDurationMs": 7401,
    "segs": [ {
      "utf8": "文法を復習してみてください。その後にN2\n、N1、N3を勉強していくと文法も"
    } ]
  }, {
    "tStartMs": 319160,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "分かりやすくなるんじゃないかなと思います。\nでも日本語って文法めっちゃありますよね。"
    } ]
  }, {
    "tStartMs": 325120,
    "dDurationMs": 6639,
    "segs": [ {
      "utf8": "もういっぱいありすぎてわけが\nわからないという声がたくさん聞こえてき"
    } ]
  }, {
    "tStartMs": 331759,
    "dDurationMs": 5241,
    "segs": [ {
      "utf8": "そうなんですが、\nじゃあここで1つ例を見てみましょう。"
    } ]
  }, {
    "tStartMs": 337000,
    "dDurationMs": 7800,
    "segs": [ {
      "utf8": "ここに何々をかねてという文法があります。\n何々をかねてというのは何々も同時に"
    } ]
  }, {
    "tStartMs": 344800,
    "dDurationMs": 7239,
    "segs": [ {
      "utf8": "行ってという意味があります。そもそも\n兼ねるという言葉は何かと何かを同時に"
    } ]
  }, {
    "tStartMs": 352039,
    "dDurationMs": 7121,
    "segs": [ {
      "utf8": "行うという意味があります。これってなん\nだか単語に似ていませんか?なので文法も"
    } ]
  }, {
    "tStartMs": 359160,
    "dDurationMs": 6599,
    "segs": [ {
      "utf8": "単語のように覚えると意味までセットで\n覚えることができるんです。意味を覚えた"
    } ]
  }, {
    "tStartMs": 365759,
    "dDurationMs": 7280,
    "segs": [ {
      "utf8": "次は例文を1つ覚えてみましょう。ここで\nはストレス発散を兼ねてジムに通っている"
    } ]
  }, {
    "tStartMs": 373039,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "という例文があります。ストレス発散を\n兼ねてなのでを兼ねての前にはストレス発散"
    } ]
  }, {
    "tStartMs": 380039,
    "dDurationMs": 6961,
    "segs": [ {
      "utf8": "が来ていますね。このように、あ、を兼ね\nての前には名刺が来るんだというよういっ"
    } ]
  }, {
    "tStartMs": 387000,
    "dDurationMs": 6440,
    "segs": [ {
      "utf8": "た感じで例文を1つ覚えるだけで接続まで\nセットで覚えられるんです。"
    } ]
  }, {
    "tStartMs": 393440,
    "dDurationMs": 10000,
    "segs": [ {
      "utf8": "なので皆さん文法を覚える時は例文まで一緒に必ず覚え\nましょう。ステップ4読解です。読解は"
    } ]
  }, {
    "tStartMs": 403440,
    "dDurationMs": 7199,
    "segs": [ {
      "utf8": "JLPTの中でも本当に点数が低くなり\nやすいところですね。皆さんも読解で苦い"
    } ]
  }, {
    "tStartMs": 410639,
    "dDurationMs": 9081,
    "segs": [ {
      "utf8": "思いをした経験があるのではないでしょうか。\nなので漢字、単語文法ですね。"
    } ]
  }, {
    "tStartMs": 419720,
    "dDurationMs": 5319,
    "segs": [ {
      "utf8": "さっきやったステップ1、ステップ2、ステップ\n3の勉強がとっても大切になってきます。"
    } ]
  }, {
    "tStartMs": 425039,
    "dDurationMs": 8521,
    "segs": [ {
      "utf8": "特にN1、N2だと読解の文章本当に長いです。\n本当に長くて出てくる感じもすごく"
    } ]
  }, {
    "tStartMs": 433560,
    "dDurationMs": 7639,
    "segs": [ {
      "utf8": "難しいんですよ。なので漢字や単語の勉強\nをしていないとまず読解の問題を読むこと"
    } ]
  }, {
    "tStartMs": 441199,
    "dDurationMs": 7201,
    "segs": [ {
      "utf8": "すらできません。またこの文章を見てみて\nください。私はご飯を食べましたという"
    } ]
  }, {
    "tStartMs": 448400,
    "dDurationMs": 7720,
    "segs": [ {
      "utf8": "文章ですが、私はご飯を食べていません。\n私はご飯を食べるだろうか?私はお母さん"
    } ]
  }, {
    "tStartMs": 456120,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "にご飯を食べさせてもらった。こんな風に\n日本語って文法がたくさんあるから私は"
    } ]
  }, {
    "tStartMs": 462520,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "ご飯を食べました。私はご飯を食べていませんで\n全く意味が変わってきてしまいます。"
    } ]
  }, {
    "tStartMs": 467440,
    "dDurationMs": 8800,
    "segs": [ {
      "utf8": "なので先に文法も勉強しておくこと\nがとても大切です。だからまとめると"
    } ]
  }, {
    "tStartMs": 476240,
    "dDurationMs": 7919,
    "segs": [ {
      "utf8": "漢字、単語、文法この3つを先に勉強してください。\nその後に読解を勉強することが"
    } ]
  }, {
    "tStartMs": 484159,
    "dDurationMs": 7720,
    "segs": [ {
      "utf8": "本当に大切になってきます。ちょっと待った。\nでも皆さん安心してください。"
    } ]
  }, {
    "tStartMs": 491879,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "読解にもコツがあります。皆さんど読解読む時最初\nから最後まで文章ちゃんと読んでませんか?"
    } ]
  }, {
    "tStartMs": 498879,
    "dDurationMs": 6641,
    "segs": [ {
      "utf8": "それってすごく時間がもったいないんです。\n読解を解く時にも時間限られていますよね。"
    } ]
  }, {
    "tStartMs": 505520,
    "dDurationMs": 7879,
    "segs": [ {
      "utf8": "なのでまず最初に質問を読んでください。\n質問を読んだ上でその質問に"
    } ]
  }, {
    "tStartMs": 513399,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "あった必要な情報を本文から探してください。\nそして2つ目に皆さん最初から"
    } ]
  }, {
    "tStartMs": 521399,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "正しい正解を選ぼうとしていませんか?\nダめです。最初から正しい答えを選ぶのではなくて、"
    } ]
  }, {
    "tStartMs": 528399,
    "dDurationMs": 6401,
    "segs": [ {
      "utf8": "間違っている問題を1つずつ探していきましょう。\nそして答えを1つずつ潰していって、"
    } ]
  }, {
    "tStartMs": 534800,
    "dDurationMs": 8400,
    "segs": [ {
      "utf8": "正解を導き出すと読解\nが早く正確に解けるようになります。"
    } ]
  }, {
    "tStartMs": 543200,
    "dDurationMs": 6759,
    "segs": [ {
      "utf8": "そして読解を解く時には問題をずっと解き\n続けるのではなくて、日本語のニュースで"
    } ]
  }, {
    "tStartMs": 549959,
    "dDurationMs": 6081,
    "segs": [ {
      "utf8": "あったり日本の本を読んでみてください。\n日本語の文章そのものに触れるということ"
    } ]
  }, {
    "tStartMs": 556040,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "もとても大切になります。これが読解を解く\n上で必要なコツです。ステップ5、聴解！です。"
    } ]
  }, {
    "tStartMs": 563480,
    "dDurationMs": 7120,
    "segs": [ {
      "utf8": "聴解はJLPTの中でも比較的点数\nが取りやすいのではないでしょうか。"
    } ]
  }, {
    "tStartMs": 570600,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "漢字が読めない。漢字が書けないていう方でも\n、聴解の点数が高いという人は実際に"
    } ]
  }, {
    "tStartMs": 576920,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "たくさんいます。なので、漢字を\nかけたり読めたりする方が大切なんですが"
    } ]
  }, {
    "tStartMs": 582680,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "、単語そのものを覚えるということも聴解\nにおいてはすごく大切になってきます。"
    } ]
  }, {
    "tStartMs": 589160,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "なので聴解の問題をたくさん聞くと\nいうのもそうですが、日本語のニュースを"
    } ]
  }, {
    "tStartMs": 595040,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "聞いたり、日本語のアニメをたくさん見\nたり、また日本語の森のように日本語で"
    } ]
  }, {
    "tStartMs": 600680,
    "dDurationMs": 6599,
    "segs": [ {
      "utf8": "説明しているYouTubeを見るのもおすめです。\nここで聴解問題のコツです。"
    } ]
  }, {
    "tStartMs": 607279,
    "dDurationMs": 8281,
    "segs": [ {
      "utf8": "聴解問題を解く時に　でも、しかし、だから\nなどのような接続詞にしっかり注目してください。"
    } ]
  }, {
    "tStartMs": 615560,
    "dDurationMs": 8279,
    "segs": [ {
      "utf8": "こうした接続詞の後に話の流れ\nがガラっと変わったり答えに繋がる言葉が"
    } ]
  }, {
    "tStartMs": 623839,
    "dDurationMs": 6321,
    "segs": [ {
      "utf8": "出てきたりすることもあるので接続詞に\n注目することがとても大切です。"
    } ]
  }, {
    "tStartMs": 630160,
    "dDurationMs": 7799,
    "segs": [ {
      "utf8": "ステップ6模擬試験を受けましょう。皆さん試験1\nヶ月前ぐらいになったら必ず模擬試験を"
    } ]
  }, {
    "tStartMs": 637959,
    "dDurationMs": 6921,
    "segs": [ {
      "utf8": "やりましょう。ただここで模擬試験をやる\n時に普通に解くのではダめです。"
    } ]
  }, {
    "tStartMs": 644880,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "時間を測ってやりましょう。この時間というのは\n実際の試験と同じ時間にすることが本当に"
    } ]
  }, {
    "tStartMs": 650800,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "大切です。ああ、もうちょっと解けない\nからあと10分だけとかやっても絶対にダメです。"
    } ]
  }, {
    "tStartMs": 656360,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "試験の時にはあと10分だけと\nいう優しい言葉はかけてもらえません。"
    } ]
  }, {
    "tStartMs": 662320,
    "dDurationMs": 8519,
    "segs": [ {
      "utf8": "特にN1、N2になると読解にすごく時間\nがかかりますよね。なので1つ1つの問題"
    } ]
  }, {
    "tStartMs": 670839,
    "dDurationMs": 5401,
    "segs": [ {
      "utf8": "にどこまでの時間をかけるかというのを\n計算することが大切になってきます。"
    } ]
  }, {
    "tStartMs": 676240,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "分からなかったらすぐに次に飛んでもう\nすぐにパッパッパッパッと解いていくこと"
    } ]
  }, {
    "tStartMs": 682120,
    "dDurationMs": 7600,
    "segs": [ {
      "utf8": "が大切になります。はい、では皆さんここ\nで広告の時間です。これだけ聞いてたら"
    } ]
  }, {
    "tStartMs": 689720,
    "dDurationMs": 7160,
    "segs": [ {
      "utf8": "じゃあ一体何の本で勉強すればいいんだっ\nて思いましたよね。日本語の森にはこの皆さんの"
    } ]
  }, {
    "tStartMs": 696880,
    "dDurationMs": 6880,
    "segs": [ {
      "utf8": "希望を叶える本が全て揃っております。\n特にこの I LOVE KANJI ですね。"
    } ]
  }, {
    "tStartMs": 703760,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "この I LOVE KANJIっていうのが部首と\nイラストとストーリーで一緒に覚えること"
    } ]
  }, {
    "tStartMs": 708920,
    "dDurationMs": 7039,
    "segs": [ {
      "utf8": "ができます。例えば指という漢字を見てみましょう。\n指。ここに読み方も書い"
    } ]
  }, {
    "tStartMs": 715959,
    "dDurationMs": 6241,
    "segs": [ {
      "utf8": "てあって意味も書いてあります。指という\n漢字は手というのとうまいという漢字が"
    } ]
  }, {
    "tStartMs": 722200,
    "dDurationMs": 5319,
    "segs": [ {
      "utf8": "合わさって指という意味になっているん\nですが、ここイラストを見てみてください。"
    } ]
  }, {
    "tStartMs": 727519,
    "dDurationMs": 5721,
    "segs": [ {
      "utf8": "女の子がケーキをさしながらこれうまいっ\nて言ってますね。"
    } ]
  }, {
    "tStartMs": 733240,
    "dDurationMs": 6640,
    "segs": [ {
      "utf8": "ケーキを指でこうやってやっています。\nのでケーキとこのうまいって言ってるのと"
    } ]
  }, {
    "tStartMs": 739880,
    "dDurationMs": 6880,
    "segs": [ {
      "utf8": "手が合わさると指という意味になります。\nそしてこの下にはJLPでよく出てくる"
    } ]
  }, {
    "tStartMs": 746760,
    "dDurationMs": 8079,
    "segs": [ {
      "utf8": "単語も一緒に乗っています。そして最後の\nところには復習もできます。"
    } ]
  }, {
    "tStartMs": 754839,
    "dDurationMs": 6799,
    "segs": [ {
      "utf8": "すごく分かりやすいですよね。\nそして今回今日からI LOVE KANJI の N1"
    } ]
  }, {
    "tStartMs": 761720,
    "dDurationMs": 3359,
    "segs": [ {
      "utf8": "が発売になりました。\nN1も難しい漢字が"
    } ]
  }, {
    "tStartMs": 765079,
    "dDurationMs": 4434,
    "segs": [ {
      "utf8": "たくさんあって覚えるの難しいと思うんですが、"
    } ]
  }, {
    "tStartMs": 769513,
    "dDurationMs": 4478,
    "segs": [ {
      "utf8": "このI LOVE KANJI を使って皆さん一緒に勉強していきましょう。"
    } ]
  }, {
    "tStartMs": 773991,
    "dDurationMs": 4001,
    "segs": [ {
      "utf8": "漢字を楽しく覚えましょう。イエーイ。"
    } ]
  }, {
    "tStartMs": 777992,
    "dDurationMs": 5928,
    "segs": [ {
      "utf8": "そして2冊目に 【この一冊で合格する】ですね。"
    } ]
  }, {
    "tStartMs": 783920,
    "dDurationMs": 8120,
    "segs": [ {
      "utf8": "【I LOVE KANJI 】で漢字を勉強した後は語彙、\n文法、読解、聴解の勉強が大切でした。"
    } ]
  }, {
    "tStartMs": 792040,
    "dDurationMs": 8400,
    "segs": [ {
      "utf8": "あと模擬試験ですね。この1冊に全て入っています。\n語彙も文法も読解も聴解も模擬試験も"
    } ]
  }, {
    "tStartMs": 800440,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "全てこの1冊で入っています。\nいろんな本を買うのすごく大変だと思うので"
    } ]
  }, {
    "tStartMs": 805880,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "日本の森が1冊にまとめたすごく便利な\n本があります。"
    } ]
  }, {
    "tStartMs": 811320,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "この中に過去に"
    } ]
  }, {
    "tStartMs": 815000,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "JLPTに出た問題がたくさん入っています。"
    } ]
  }, {
    "tStartMs": 818067,
    "dDurationMs": 5221,
    "segs": [ {
      "utf8": "そしてこの冊だけで合格\nしたという学生さんもたくさんいます。"
    } ]
  }, {
    "tStartMs": 823288,
    "dDurationMs": 8168,
    "segs": [ {
      "utf8": "そして皆さんのおかげでJLPT、この一冊で合格する\n日本語の森で出しているこの本が"
    } ]
  }, {
    "tStartMs": 831456,
    "dDurationMs": 5144,
    "segs": [ {
      "utf8": "Amazonのランキングで1位になっています。\n皆さんいつもありがとうございます。"
    } ]
  }, {
    "tStartMs": 836600,
    "dDurationMs": 3797,
    "segs": [ {
      "utf8": "この本を使ってみんなで一緒に勉強していきましょう。"
    } ]
  }, {
    "tStartMs": 840397,
    "dDurationMs": 7242,
    "segs": [ {
      "utf8": "そして3冊目に最近全部出ましたFAST PASS の本ですね。このFAST PASSの本は"
    } ]
  }, {
    "tStartMs": 847639,
    "dDurationMs": 6640,
    "segs": [ {
      "utf8": "こっちのこの一冊で合格すよりも単語の\n数としては少ないんですが、JLPTで"
    } ]
  }, {
    "tStartMs": 854279,
    "dDurationMs": 5721,
    "segs": [ {
      "utf8": "たくさん何回も出てきたすごく大切な単語\nがたくさん入っている単語帳になっています。"
    } ]
  }, {
    "tStartMs": 860000,
    "dDurationMs": 6800,
    "segs": [ {
      "utf8": "これはね、あの、電車の中とかどこか移動しながらとか、あの、なんだろう、"
    } ]
  }, {
    "tStartMs": 866800,
    "dDurationMs": 6839,
    "segs": [ {
      "utf8": "休憩中とかそういう時に手軽に見て\nいただきたいなと思います。そしてこの"
    } ]
  }, {
    "tStartMs": 873639,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "FAST PASSが中に、えー、漢字も一緒に\n書かれています。なので単語を覚える時に"
    } ]
  }, {
    "tStartMs": 881079,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "一緒に漢字の意味も理解しながら覚える\nことができるので、すごく早く覚えること"
    } ]
  }, {
    "tStartMs": 886839,
    "dDurationMs": 7041,
    "segs": [ {
      "utf8": "ができます。今このFAST PASSが英語に\nしか対応していないので、"
    } ]
  }, {
    "tStartMs": 893880,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "英語が分かる方はこれで勉強して\nいただけるとすごくいいかなと思います。"
    } ]
  }, {
    "tStartMs": 898600,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "これから日本語の森が頑張っていろんな\n言語に翻訳していくので、皆さん楽しみに"
    } ]
  }, {
    "tStartMs": 904040,
    "dDurationMs": 6960,
    "segs": [ {
      "utf8": "待っていてください。そしてこの本を\n買える場所はと言いますと、日本に住んでいる方は"
    } ]
  }, {
    "tStartMs": 911000,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "日本の紀伊国屋の本屋さんに行く\nと直接見ることができます。"
    } ]
  }, {
    "tStartMs": 917560,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "もしくはAmazonや楽天でも購入することが\nできます。日本以外の国に住んでいる方は"
    } ]
  }, {
    "tStartMs": 923920,
    "dDurationMs": 6120,
    "segs": [ {
      "utf8": "Amazonでご購入いただけます。\n詳しくは概要欄に書いておきますので、"
    } ]
  }, {
    "tStartMs": 930040,
    "dDurationMs": 7200,
    "segs": [ {
      "utf8": "そちらのリンクから見てみてください。\nはい、皆さんお疲れ様でした。"
    } ]
  }, {
    "tStartMs": 937240,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "最近のJLPT本当に難しくなってきていますよね。"
    } ]
  }, {
    "tStartMs": 940880,
    "dDurationMs": 7449,
    "segs": [ {
      "utf8": "なので私たちと一緒に少しでも効率よく楽しく分かりやすく日本語を勉強していきましょう。"
    } ]
  }, {
    "tStartMs": 948329,
    "dDurationMs": 4870,
    "segs": [ {
      "utf8": "次のJPTもみんなで一緒に頑張っていきましょうね。"
    } ]
  }, {
    "tStartMs": 953199,
    "dDurationMs": 4801,
    "segs": [ {
      "utf8": "みんなで合格するぞ。イエー。"
    } ]
  } ]
}
