{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 680,
    "dDurationMs": 6159,
    "segs": [ {
      "utf8": "皆さん、こんにちは。日本語の森のあいり\nです。今日は一緒に慣用句勉強していきましょう。"
    } ]
  }, {
    "tStartMs": 6839,
    "dDurationMs": 8760,
    "segs": [ {
      "utf8": "慣用句2つ以上の単語が結合して\n全体が特定の意味を表わす言い回しです。"
    } ]
  }, {
    "tStartMs": 15599,
    "dDurationMs": 9121,
    "segs": [ {
      "utf8": "難しいですね。例えば頭が痛い。\n天気が悪くて頭が痛い。そんな時も使いますよね。"
    } ]
  }, {
    "tStartMs": 24720,
    "dDurationMs": 5959,
    "segs": [ {
      "utf8": "ただそれだけではなく、何か\n困ったことがあった時に頭が痛いという言葉を使います。"
    } ]
  }, {
    "tStartMs": 30679,
    "dDurationMs": 9841,
    "segs": [ {
      "utf8": "なかなかあの子の成績が\n上がらなくて頭が痛いなとか耳が痛い。"
    } ]
  }, {
    "tStartMs": 40520,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "大きな音がして耳が痛いという風にも\n使えるんですが何か聞きたくないことが"
    } ]
  }, {
    "tStartMs": 46320,
    "dDurationMs": 6879,
    "segs": [ {
      "utf8": "あった時に耳が痛いを使います。例えば\nいつまでゲームしてるの?勉強しなさい。"
    } ]
  }, {
    "tStartMs": 53199,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "次のテストもうすぐなんだから勉強しない\nとダめでしょう。こんな風に言われたく"
    } ]
  }, {
    "tStartMs": 58239,
    "dDurationMs": 6640,
    "segs": [ {
      "utf8": "ない言葉を言われた時にも耳が痛いという\n言葉を使います。このようにそれだけの"
    } ]
  }, {
    "tStartMs": 64879,
    "dDurationMs": 7761,
    "segs": [ {
      "utf8": "意味ではなく他の表現他の意味を表す\n言い回しの時に使う言葉を慣用句と言います。"
    } ]
  }, {
    "tStartMs": 72640,
    "dDurationMs": 8080,
    "segs": [ {
      "utf8": "では今日は口を使った慣用句10個勉強し\nていきたいと思います。前回は目を勉強しましたね。"
    } ]
  }, {
    "tStartMs": 80720,
    "dDurationMs": 7439,
    "segs": [ {
      "utf8": "今回は口を使った慣用句です。\nでは1つ目の慣用句行ってみましょう。"
    } ]
  }, {
    "tStartMs": 88159,
    "dDurationMs": 7761,
    "segs": [ {
      "utf8": "1つ目、口が硬い。口が硬いというのは口の\n筋肉が固まって動かないという意味ではありません。"
    } ]
  }, {
    "tStartMs": 95920,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": " \n秘密を人に話さないという意味があります。"
    } ]
  }, {
    "tStartMs": 101040,
    "dDurationMs": 6719,
    "segs": [ {
      "utf8": "何か秘密があった時に誰かには相談し\nたいけどこのことはみんなには言わないで"
    } ]
  }, {
    "tStartMs": 107759,
    "dDurationMs": 6201,
    "segs": [ {
      "utf8": "欲しい。あ、でもあの子だったら私の秘密\n言わないでおいてくれるな。そう言った時"
    } ]
  }, {
    "tStartMs": 113960,
    "dDurationMs": 8360,
    "segs": [ {
      "utf8": "にあの子は口が硬いという風に使います。\nあいりは口が硬いから何でも相談できる。"
    } ]
  }, {
    "tStartMs": 122320,
    "dDurationMs": 5719,
    "segs": [ {
      "utf8": "最近彼氏ができたんだけどみんなにはまだ\nこのこと知られたくないな。でも彼氏の"
    } ]
  }, {
    "tStartMs": 128039,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "こと相談したいな。あ、あいりだったら\n秘密を言わないでいてくれる。あいりは口が"
    } ]
  }, {
    "tStartMs": 134599,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "硬いから何でも相談できる。そんな言いたい時\nに使われます。"
    } ]
  }, {
    "tStartMs": 140599,
    "dDurationMs": 6640,
    "segs": [ {
      "utf8": "2つ目。口が軽いです。口が軽い。口が\n軽くてもうどっかぴょんぴょンぴょンって"
    } ]
  }, {
    "tStartMs": 147239,
    "dDurationMs": 5201,
    "segs": [ {
      "utf8": "飛んでっちゃう。そういった意味ではあり\nません。口の重さがないという意味でも"
    } ]
  }, {
    "tStartMs": 152440,
    "dDurationMs": 8600,
    "segs": [ {
      "utf8": "ありません。秘密をすぐ人に話すという\n意味です。さっきの口が硬いと反対の意味"
    } ]
  }, {
    "tStartMs": 161040,
    "dDurationMs": 7080,
    "segs": [ {
      "utf8": "ですね。あいりは口が軽いから大事なことは\n話さない方がいいよ。"
    } ]
  }, {
    "tStartMs": 168120,
    "dDurationMs": 5399,
    "segs": [ {
      "utf8": "ああ、彼氏ができたこと。あいりは口が\n硬いと思って話したのに、次の日には"
    } ]
  }, {
    "tStartMs": 173519,
    "dDurationMs": 6401,
    "segs": [ {
      "utf8": "みんなが知ってるんだけど、あれ、あいり\nめっちゃ口軽いじゃん。秘密すぐ人に話し"
    } ]
  }, {
    "tStartMs": 179920,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "ちゃったじゃん。そういった時に使われ\nます。口が軽い人に話すと次の日には"
    } ]
  }, {
    "tStartMs": 185760,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "クラスみんながその話を知っていてすごく\n困りますよね。そういった時に彼女は口が軽い。"
    } ]
  }, {
    "tStartMs": 191720,
    "dDurationMs": 9360,
    "segs": [ {
      "utf8": "そういった風に使われます。\nでは3つ目。口が滑るです。口が滑って転んだ"
    } ]
  }, {
    "tStartMs": 201080,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "そういう意味ではありません。口が滑\nるっていうのは言ってはいけないこと、"
    } ]
  }, {
    "tStartMs": 206680,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "言わなくていいことを言うという意味です。\nなのでさっきの、みんなには言わないでね。"
    } ]
  }, {
    "tStartMs": 212640,
    "dDurationMs": 5239,
    "segs": [ {
      "utf8": "実は私彼氏ができたんだけど\nこのことみんなには言わないでねって言っ"
    } ]
  }, {
    "tStartMs": 217879,
    "dDurationMs": 7841,
    "segs": [ {
      "utf8": "たのにあ、ごめん。口が滑ってあの子に\n話しちゃった。言わなくていいこと。言っ"
    } ]
  }, {
    "tStartMs": 225720,
    "dDurationMs": 5799,
    "segs": [ {
      "utf8": "ちゃいけないことあの子についつい言っ\nちゃったっていう時に口が滑ると言います。"
    } ]
  }, {
    "tStartMs": 231519,
    "dDurationMs": 8401,
    "segs": [ {
      "utf8": "口がが滑って上司を怒らせてしまった。\nわざわざ言わなくていいことを上司に"
    } ]
  }, {
    "tStartMs": 239920,
    "dDurationMs": 7080,
    "segs": [ {
      "utf8": "言ってしまって上司が怒ってしまった。\nそういった時にも口が滑るを使います。"
    } ]
  }, {
    "tStartMs": 247000,
    "dDurationMs": 7560,
    "segs": [ {
      "utf8": "では4つ目。口を出すです。口を出す。口\nが前にこう出てきてなんか歩き出すとか"
    } ]
  }, {
    "tStartMs": 254560,
    "dDurationMs": 5519,
    "segs": [ {
      "utf8": "そういう意味でもなく口がこう前に\nピーンって出てくるとかでもないです。"
    } ]
  }, {
    "tStartMs": 260079,
    "dDurationMs": 7881,
    "segs": [ {
      "utf8": "これはお願いされていないのに意見を言う\nことを言います。よくお母さんが私たちの"
    } ]
  }, {
    "tStartMs": 267960,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "話に口を出してくるとか言いますね。私と\n彼氏の問題なのにお母さんがいや、あの人"
    } ]
  }, {
    "tStartMs": 274280,
    "dDurationMs": 4359,
    "segs": [ {
      "utf8": "はやめといた方がいいよ。あのあの男は\n良くないからやめといた方がいいよ。"
    } ]
  }, {
    "tStartMs": 278639,
    "dDurationMs": 6801,
    "segs": [ {
      "utf8": "いや、私たちの問題だから。お母さんは口を\n出さないで。そんな時に使います。"
    } ]
  }, {
    "tStartMs": 285440,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "子供のやることに口を出してはいけない。あ、\n子供がもう今にも転びそうとか、あ、子供"
    } ]
  }, {
    "tStartMs": 291400,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "がいや、手が汚いままご飯食べちゃだめだ\nよとか、なんかそういういろんなことを"
    } ]
  }, {
    "tStartMs": 296360,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "言いたくなりますよね。でも子供の成長の\nためを願って何も言わないっていうのも"
    } ]
  }, {
    "tStartMs": 302400,
    "dDurationMs": 5639,
    "segs": [ {
      "utf8": "大事なことです。なので何でもかんでも口\nを出してあれはダメ、これはダメとかって"
    } ]
  }, {
    "tStartMs": 308039,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "言わないようにしましょうね。\nでは5つ目。口がうまいです。口がうまい"
    } ]
  }, {
    "tStartMs": 314759,
    "dDurationMs": 7681,
    "segs": [ {
      "utf8": "あ、口美味しい。口もぐもぐい\nという意味ではありません。"
    } ]
  }, {
    "tStartMs": 322440,
    "dDurationMs": 6479,
    "segs": [ {
      "utf8": "口がうまいというのは話をするのがうまいという意味\nです。話をするのがうまい。"
    } ]
  }, {
    "tStartMs": 328919,
    "dDurationMs": 6201,
    "segs": [ {
      "utf8": "この服買うつもりなくてただ見てただけなのに。\nあら、その洋服お似合いですね。"
    } ]
  }, {
    "tStartMs": 335120,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "あ、サイズもぴったり。あ、色も合ってる。\nすごく似合ってます。しかもこの服、この"
    } ]
  }, {
    "tStartMs": 340840,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "お店で最後の1個なんですよ。もうこれは\n買うしかないですよね。そんなこと言われ"
    } ]
  }, {
    "tStartMs": 347000,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "たら買うつもりなかったのについつい買っ\nちゃいますよね。そんな風に口がうまい。"
    } ]
  }, {
    "tStartMs": 352800,
    "dDurationMs": 7160,
    "segs": [ {
      "utf8": "話をするのがうまい人のことを口がうまい\nと言います。口がうまいね。1つ買うよ。"
    } ]
  }, {
    "tStartMs": 359960,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "よく使いますね。市場とか皆さん言った\nことありますか?市場のね、おじさんとか"
    } ]
  }, {
    "tStartMs": 365160,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "がああ、この魚は今日めっちゃうまいよ。\nあ、今日取れたてだよ。いや、そんなこと"
    } ]
  }, {
    "tStartMs": 370880,
    "dDurationMs": 5319,
    "segs": [ {
      "utf8": "言われたら買うつもりなかったけど、あ、\n人使うよ。そんな時に口がうまいを使います。"
    } ]
  }, {
    "tStartMs": 376199,
    "dDurationMs": 8881,
    "segs": [ {
      "utf8": "はい。では6個目。口が悪いです。\n口が悪いというのは口が病気で痛いとか"
    } ]
  }, {
    "tStartMs": 385080,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "何か悪くなってしまったという意味では\nありません。"
    } ]
  }, {
    "tStartMs": 390120,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "使う言葉や言い方が悪い時にこの言葉を\n使います。最近彼氏ができたって言ってた"
    } ]
  }, {
    "tStartMs": 396680,
    "dDurationMs": 7120,
    "segs": [ {
      "utf8": "けど彼氏どんな人?うーん。優しいんだ\nけどちょっと口が悪いんだよね。"
    } ]
  }, {
    "tStartMs": 403800,
    "dDurationMs": 6600,
    "segs": [ {
      "utf8": "私に対してバカとかアホとか結構言ってくるんだよね。\nああ、その口が悪いのはちょっと困るね。"
    } ]
  }, {
    "tStartMs": 410400,
    "dDurationMs": 7479,
    "segs": [ {
      "utf8": "そんな時に言います。\n彼は口が悪いだけで本当は優しいよ。"
    } ]
  }, {
    "tStartMs": 417879,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "こんな風にバカとかアホとか言ってくる\nけど、ま、でも実はすごく優しい人なんだよね。"
    } ]
  }, {
    "tStartMs": 423759,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "そんな風に悪い人ではなく、言い方\nがきつかったりとか、ま、言い方使う言葉"
    } ]
  }, {
    "tStartMs": 430759,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "が悪いという時に口が悪いという言葉を使います。\n7個目。口が酸っぱくなるです。"
    } ]
  }, {
    "tStartMs": 437319,
    "dDurationMs": 7921,
    "segs": [ {
      "utf8": "皆さんレモンとか梅干とか食べた時口の\n中うーんて酸っぱくなりますよね。"
    } ]
  }, {
    "tStartMs": 445240,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "うんって酸っぱくなる。それもあるんですが、\n今回は慣用句なのでその意味ではありません。"
    } ]
  }, {
    "tStartMs": 450720,
    "dDurationMs": 4879,
    "segs": [ {
      "utf8": " \n同じことを何度も言うという意味があります。"
    } ]
  }, {
    "tStartMs": 455599,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "勉強しないと合格できないよって口\nが酸っぱくなるほど言ったのに"
    } ]
  }, {
    "tStartMs": 463599,
    "dDurationMs": 6761,
    "segs": [ {
      "utf8": "結局勉強しなかったのだから試験に落ちた\nんだよ。そんな風に使われます。"
    } ]
  }, {
    "tStartMs": 470360,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "もう何回も何回もそのことを繰り返し言った時に口\nが酸っぱくなるほど言う。え、お母さんが"
    } ]
  }, {
    "tStartMs": 476400,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "口が酸っぱくなるほど勉強しろって言った\nでしょうとか、あ、これはもうこれはやっ"
    } ]
  }, {
    "tStartMs": 481520,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "ちゃいけないって私小さい頃からもう口が\n酸っぱくなるほど言ったでしょう。"
    } ]
  }, {
    "tStartMs": 486960,
    "dDurationMs": 5959,
    "segs": [ {
      "utf8": "そういった時に、え、使われます。同じことを\n何度も言うという意味ですね。"
    } ]
  }, {
    "tStartMs": 492919,
    "dDurationMs": 7641,
    "segs": [ {
      "utf8": "レモンを食べてうーんってなることではないですよ。\nでは8個目。口に合うです。口に合う。"
    } ]
  }, {
    "tStartMs": 500560,
    "dDurationMs": 6759,
    "segs": [ {
      "utf8": "口に合う。こうサイズがぴったりという\n意味ではありません。口に合うというのは"
    } ]
  }, {
    "tStartMs": 507319,
    "dDurationMs": 6561,
    "segs": [ {
      "utf8": "自分の好きな味ということです。自分の口\nに、え、すごくこれが美味しいと感じる"
    } ]
  }, {
    "tStartMs": 513880,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "もののことですね。お口に合いますか?皆\nさん、え、レストランとか行った時に聞か"
    } ]
  }, {
    "tStartMs": 520880,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "れたことありませんか?ご飯食べてたら\nレストランの店員さんが、"
    } ]
  }, {
    "tStartMs": 526240,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "お口に合いましたでしょうか?そのお口に合いました\nでしょうかっていうのはこのレモンの"
    } ]
  }, {
    "tStartMs": 530920,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "サイズが口にぴったりあったということで\nはなく、レモンの味が自分にとってすごく"
    } ]
  }, {
    "tStartMs": 536680,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "好きな味でしたかという意味です。皆さん\n、あの、レストラン行って"
    } ]
  }, {
    "tStartMs": 541440,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "お口に合いましたかって言って、あ、サイズぴったりなん\nですってやらないようにしてくださいね。"
    } ]
  }, {
    "tStartMs": 544920,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "もう本当びっくりしちゃうので自分の好き\nな味、自分にぴったり、え、合う、すごく"
    } ]
  }, {
    "tStartMs": 550680,
    "dDurationMs": 7719,
    "segs": [ {
      "utf8": "美味しいと感じる味という意味です。\nでは9個目。口が寂しい。口が寂しいはどんな"
    } ]
  }, {
    "tStartMs": 558399,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "意味でしょうか?あ、口がなんか1人で\nなんか寂しくしてるな。話し相手がなんか"
    } ]
  }, {
    "tStartMs": 564959,
    "dDurationMs": 7681,
    "segs": [ {
      "utf8": "いないなとかそういう意味ではないです。\nお腹は空いてないけど何か食べたい。"
    } ]
  }, {
    "tStartMs": 572640,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "皆さんよくありませんか?なんかさっきお\n昼ご飯食べてお腹は空いてないんだけど"
    } ]
  }, {
    "tStartMs": 577720,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "なんかちょっと食べたいな。ああ、じゃあ\nここにあるお菓子ちょっと食べちゃおうかな。"
    } ]
  }, {
    "tStartMs": 582640,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "そういった時に口が寂しいを使います\n。なんかさっきご飯食べたんだけどなんか"
    } ]
  }, {
    "tStartMs": 588600,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "口寂しいな。なんか食べたいな。なんか\nそんなちゃんとご飯を食べるわけじゃない"
    } ]
  }, {
    "tStartMs": 594000,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "んだけどちょっとなんか飴食べてみよう。\nあ、ちょっとなんかチョコ食べてみよう。"
    } ]
  }, {
    "tStartMs": 600040,
    "dDurationMs": 5039,
    "segs": [ {
      "utf8": "そういった時に口が寂しいよ言います。\n口が寂しいとガム食べたり、ミンティア"
    } ]
  }, {
    "tStartMs": 605079,
    "dDurationMs": 6880,
    "segs": [ {
      "utf8": "食べたりしますよね。私は結構口が寂しい\n時ミンティア食べがちです。"
    } ]
  }, {
    "tStartMs": 611959,
    "dDurationMs": 4921,
    "segs": [ {
      "utf8": "では最後10個目。あいた口が塞がらない。あいた口が塞がらないというのはどういう意味でしょう?"
    } ]
  }, {
    "tStartMs": 616880,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "ポカンってしてるという意味ですね。\nああってなって。"
    } ]
  }, {
    "tStartMs": 622200,
    "dDurationMs": 7600,
    "segs": [ {
      "utf8": "ただなんかこうああ、口が閉まらないと\nいう意味ではないです。これはもうとても"
    } ]
  }, {
    "tStartMs": 629800,
    "dDurationMs": 7400,
    "segs": [ {
      "utf8": "呆きれたりとかとてもびっくりした時に\nあいた口が塞がらないと言います。"
    } ]
  }, {
    "tStartMs": 637200,
    "dDurationMs": 8840,
    "segs": [ {
      "utf8": "あいた口が塞がらないよ。え、そうだった\nのみたいな時ね。例えば、え、あの2人"
    } ]
  }, {
    "tStartMs": 646040,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "付き合ったの?すごく喧嘩してて仲悪かっ\nたのに。え、付き合ったんだ。え、しかも"
    } ]
  }, {
    "tStartMs": 652440,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "結婚するの。ええ、[叫び声]\n口が閉まらない。こんな時に"
    } ]
  }, {
    "tStartMs": 660440,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "あいた口が塞がらないという言葉を使います。\n皆さんもなんかびっくりしたりとかした時"
    } ]
  }, {
    "tStartMs": 666440,
    "dDurationMs": 7079,
    "segs": [ {
      "utf8": "あいた口が塞がらないですか?ま、あとは\nとても呆きれた時にああ、だから勉強"
    } ]
  }, {
    "tStartMs": 673519,
    "dDurationMs": 7120,
    "segs": [ {
      "utf8": "しろって言ったよね。ああ、結局落ちたの\nね。試験にね、落ちちゃったんだみたいな"
    } ]
  }, {
    "tStartMs": 680639,
    "dDurationMs": 5241,
    "segs": [ {
      "utf8": "時にああ、あいた口が塞がらない。とても\n呆きれてるよっていう時にも"
    } ]
  }, {
    "tStartMs": 685880,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "あいた口が塞がらないを使います。\n皆さんお疲れ様でした。慣用句10個一緒に勉強してきましたね。"
    } ]
  }, {
    "tStartMs": 692120,
    "dDurationMs": 7240,
    "segs": [ {
      "utf8": "今回は口を使った慣用句でした。\nよく使う慣用句なので是非皆さんもたくさん"
    } ]
  }, {
    "tStartMs": 699360,
    "dDurationMs": 6640,
    "segs": [ {
      "utf8": "使ってみてください。\nではまた次の動画でお会いしましょう。"
    } ]
  }, {
    "tStartMs": 708063,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": " "
    } ]
  }, {
    "tStartMs": 719800,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": " "
    } ]
  }, {
    "tStartMs": 723040,
    "dDurationMs": 7680,
    "segs": [ {
      "utf8": " "
    } ]
  }, {
    "tStartMs": 749959,
    "dDurationMs": 7201,
    "segs": [ {
      "utf8": " "
    } ]
  } ]
}
