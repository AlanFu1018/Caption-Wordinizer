    } ]
  }, {
    "tStartMs": 811320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうこのもこの中に過去にこう",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 814870,
    "wWinId": 1,
    "aAppend": 1,
