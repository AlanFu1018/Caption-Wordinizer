    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 43039,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずは絶対に漢字から勉強してください。でも先生漢字覚えるの難しいよ。分かります。漢字本当に難しいですよね。じゃあまずはこの感じを見てください。",
      "acAsrConf": 0
    } ]
  }, {
