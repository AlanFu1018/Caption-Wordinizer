      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 832959,
    "dDurationMs": 3641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "位になっています。皆さんいつもありがとうございます。",
      "acAsrConf": 0
    } ]
  }, {
