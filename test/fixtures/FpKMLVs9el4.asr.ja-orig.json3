  }, {
    "tStartMs": 29840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どんな本を使えばいいのかという質問をたくさんいただきます。なので今回はどういう本を使って勉強すればいいのかということを全部シェアしていきたいと思います。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 41750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 41760,
    "dDurationMs": 4279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ステップ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 440,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 43029,
