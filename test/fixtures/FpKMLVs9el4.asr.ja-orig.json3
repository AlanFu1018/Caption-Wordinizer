    } ]
  }, {
    "tStartMs": 827760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "冊で合格する日本語の森で出しているこの本が",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 831350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 831360,
    "dDurationMs": 4429,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Amazon",
      "acAsrConf": 0
    }, {
      "utf8": "のランキングで",
      "tOffsetMs": 399,
      "acAsrConf": 0
    }, {
      "utf8": "1",
