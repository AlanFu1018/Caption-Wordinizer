    "segs": [ {
      "utf8": "JLPT",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 815470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 815480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "に出た問題がたくさん入っています。そしてこの",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 819150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 819160,
    "dDurationMs": 3200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 819350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 819360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "冊だけで合格したという学生さんもたくさんいます。そして皆さんのおかげで",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 825350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 825360,
    "dDurationMs": 5400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "JLPT",
      "acAsrConf": 0
    }, {
      "utf8": "のこのね、この",
      "tOffsetMs": 800,
      "acAsrConf": 0
    }, {
      "utf8": "1",
